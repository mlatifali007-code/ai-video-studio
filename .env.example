# Local planner, clip import and export need NO keys.
# Optional free-tier cloud auth/database. Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for protected video job updates. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Leave false for zero budget. Enable ONLY after explicit spending approval.
ENABLE_PAID_GENERATION=false
FAL_KEY=
# Optional self-hosted AI director. Local model computing/hardware is your responsibility.
# Never expose an unauthenticated Ollama server publicly.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
